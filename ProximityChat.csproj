<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>2.0.2</Version>
    </PropertyGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="RayTraceApi\**\*.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CounterStrikeSharp.API" Version="1.0.369" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="CounterStrikeSharp.API" Version="1.0.368" Condition="'$(TargetFramework)' == 'net8.0'" />
        <PackageReference Include="MessagePack" Version="3.1.7" />
        <PackageReference Include="SocketIOClient" Version="4.0.4" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="RayTraceApi\managed\RayTrace\RayTraceApi\RayTraceApi.csproj" />
    </ItemGroup>
</Project>
